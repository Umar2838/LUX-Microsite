VMODEL_API_TOKEN=your-vmodel-api-token
VMODEL_VERSION=537e83f7ed84751dc56aa80fb2391b07696c85a49967c72c64f002a0ca2bb224

# OpenAI image edit API from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional image compression settings for OpenAI uploads (max 2 MB)
# OPENAI_IMAGE_MAX_DIMENSION=1536
# OPENAI_IMAGE_MAX_BYTES=2097152
# OPENAI_IMAGE_JPEG_QUALITY=85

# Your public AWS app URL (VModel fetches images/videos from /media/)
PUBLIC_BASE_URL=https://your-app.example.com

# Optional: use a pre-hosted target video URL instead of media/videos/
# VMODEL_TARGET_VIDEO_URL=https://your-app.example.com/media/videos/target_vedio.mp4
